# ============================================================
# GroupsGuru — Environment Variables
# Copy this file to .env for local dev (never commit .env)
# Set ALL of these as Environment Variables on Render for prod
# ============================================================

# --- REQUIRED (app will crash in prod without these) ---

# Random 64-character string — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin account password (used when seeding jayaramadmin on first boot)
ADMIN_PASSWORD=

# --- PAYMENTS (required for subscriptions to work) ---

# Razorpay keys — use rzp_test_* for dev, rzp_live_* for prod
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- EMAIL (needed for forgot-password to work) ---

# Gmail address + App Password (not your Gmail password)
# Create App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# --- OPTIONAL (Google OAuth login) ---

# From Google Cloud Console → APIs & Services → Credentials
# Authorized Redirect URI: https://groupsguru.in/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
